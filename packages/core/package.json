{
  "name": "@vapi-network/core",
  "version": "0.5.0",
  "description": "Non-custodial x402 protocol, wallet policy, discovery, and receipts core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vAPI-Network/vapi-network.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/vAPI-Network/vapi-network#readme",
  "bugs": {
    "url": "https://github.com/vAPI-Network/vapi-network/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "import": "./dist/secrets.js"
    },
    "./api-key": {
      "types": "./dist/api-key.d.ts",
      "import": "./dist/api-key.js"
    },
    "./agent-link": {
      "types": "./dist/agent-link.d.ts",
      "import": "./dist/agent-link.js"
    },
    "./router-client": {
      "types": "./dist/router-client.d.ts",
      "import": "./dist/router-client.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs index=src/index.ts secrets=src/secrets.ts api-key=src/api-key.ts agent-link=src/agent-link.ts router-client=src/router-client.ts",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm --dir ../.. pack:check",
    "publish:npm": "pnpm pack:check && npm publish ./publish --access public --tag latest",
    "publish:npm:next": "pnpm pack:check && npm publish ./publish --access public --tag next"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.1.0",
    "@x402/svm": "2.25.0",
    "viem": "^2.43.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "ed25519-hd-key": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
