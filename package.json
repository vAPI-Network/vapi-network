{
  "name": "vapi-network-workspace",
  "version": "0.2.0-dev.2",
  "private": true,
  "description": "Open-source, non-custodial access to x402 APIs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:pay": "pnpm build && node --experimental-strip-types examples/pay-with-sdk.ts",
    "prepare:publish": "pnpm build && node scripts/prepare-publish.mjs",
    "pack:check": "pnpm prepare:publish && node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.6",
    "eslint": "^10.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vAPI-Network/vapi-network.git"
  },
  "bugs": {
    "url": "https://github.com/vAPI-Network/vapi-network/issues"
  },
  "homepage": "https://github.com/vAPI-Network/vapi-network#readme"
}
