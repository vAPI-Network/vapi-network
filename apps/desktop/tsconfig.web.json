{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts",
    "src/signer/messages.ts",
    "src/shared/**/*"
  ]
}
